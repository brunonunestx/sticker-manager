{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node src/main.ts'",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "prisma": "prisma --config infra/prisma.config.ts",
    "migrate": "prisma migrate dev --config infra/prisma.config.ts",
    "generate": "prisma generate --config infra/prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.27",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
